JWT_SECRET=
JWT_EXPIRES_IN=15m
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# --- Added as placeholders to match backend/src/config/env.js (do not put real values here) ---
# Required: PostgreSQL connection string used by backend/src/database/pool.js
DATABASE_URL=
# Optional: HTTP port (defaults to 5000 in backend/src/config/env.js)
PORT=5000
# Effectively required: must exactly match the deployed frontend origin (CORS + origin check)
FRONTEND_URL=http://localhost:5173
# Optional: NODE_ENV=production enables secure cookies (backend/src/modules/auth/auth.cookie.js)
NODE_ENV=development
# Optional: orphan-cleanup interval in ms (defaults to 86400000 = 24h in backend/src/config/env.js)
ORPHAN_CLEANUP_INTERVAL_MS=86400000

RESEND_API_KEY=